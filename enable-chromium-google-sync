#!/bin/bash
set -euo pipefail

# ============================================================
# Chromium Google Services / Sync
# ============================================================
#
# Enables Google account sign-in and Google Sync for native
# Debian-compatible Chromium installations.
#
# The installer keeps distribution-provided Chromium files
# intact and adds separate configuration files under /etc.
#
# Intended for native Chromium packages that use:
#
#   /etc/chromium.d/
#
# Examples include Raspberry Pi OS / Debian Chromium.
# ============================================================

echo "=================================================="
echo " Chromium Google Services / Sync"
echo "=================================================="
echo
echo "This installer enables Google account sign-in"
echo "and Google Sync in Chromium."
echo
echo "The configuration will apply system-wide"
echo "to all users."
echo
echo "All running Chromium windows will be closed."
echo

# ------------------------------------------------------------
# Ask before making any changes.
#
# No administrator password is requested until the user
# explicitly chooses Yes.
# ------------------------------------------------------------

read -r -p "Install Google services for Chromium? [y/N]: " answer

case "$answer" in
    y|Y|yes|YES|Yes) ;;
    *)
        echo
        echo "Installation cancelled."
        exit 0
        ;;
esac

# ------------------------------------------------------------
# Basic requirements.
#
# python3 is used by the profile compatibility helper.
# ------------------------------------------------------------

if ! command -v python3 >/dev/null 2>&1; then
    echo
    echo "ERROR: python3 is required but was not found."
    exit 1
fi

# ------------------------------------------------------------
# Detect a supported native Chromium installation.
#
# This project is not intended for Google Chrome, Flatpak
# Chromium, or Chromium Snap.
# ------------------------------------------------------------

CHROMIUM_BIN=""

if command -v chromium >/dev/null 2>&1; then
    CHROMIUM_BIN="$(command -v chromium)"
elif command -v chromium-browser >/dev/null 2>&1; then
    CHROMIUM_BIN="$(command -v chromium-browser)"
else
    echo
    echo "ERROR: Chromium is not installed."
    exit 1
fi

CHROMIUM_REAL="$(readlink -f "$CHROMIUM_BIN" 2>/dev/null || printf '%s' "$CHROMIUM_BIN")"

case "$CHROMIUM_REAL" in
    /snap/*)
        echo
        echo "ERROR: Chromium Snap was detected."
        echo "This installer requires a native Debian-compatible"
        echo "Chromium installation."
        exit 1
        ;;
esac

if [ ! -d /etc/chromium.d ]; then
    echo
    echo "ERROR: /etc/chromium.d does not exist."
    echo
    echo "This installer requires a native Debian-compatible"
    echo "Chromium installation."
    exit 1
fi

# ------------------------------------------------------------
# Obtain administrator privileges.
#
# Start the script normally:
#
#   ./enable-chromium-google-sync
#
# sudo is requested only after installation was confirmed.
# ------------------------------------------------------------

echo
echo "Compatible Chromium installation detected."

if [ "$EUID" -eq 0 ]; then
    SUDO=()
else
    if ! command -v sudo >/dev/null 2>&1; then
        echo
        echo "ERROR: sudo is not installed."
        exit 1
    fi

    echo "Administrator privileges are required."
    sudo -v
    SUDO=(sudo)
fi

# ------------------------------------------------------------
# Check the distribution-provided Google API configuration.
#
# Debian / Raspberry Pi Chromium normally provides:
#
#   /etc/chromium.d/apikeys
#
# This installer does NOT modify that file.
# ------------------------------------------------------------

echo
echo "Checking Chromium API configuration..."

if [ -f /etc/chromium.d/apikeys ]; then
    echo "Existing Chromium API configuration detected."
else
    echo
    echo "WARNING: /etc/chromium.d/apikeys was not found."
    echo "Google services may not work correctly on this"
    echo "Chromium build."
fi

# ------------------------------------------------------------
# Stop Chromium before changing its configuration.
#
# First request a normal shutdown. If Chromium still has
# processes running after 10 seconds, stop those processes.
# ------------------------------------------------------------

echo
echo "Stopping all running Chromium processes..."

"${SUDO[@]}" pkill -TERM -x chromium 2>/dev/null || true
"${SUDO[@]}" pkill -TERM -x chromium-browser 2>/dev/null || true

for i in {1..10}; do
    if ! pgrep -x chromium >/dev/null 2>&1 &&
       ! pgrep -x chromium-browser >/dev/null 2>&1; then
        break
    fi
    sleep 1
done

"${SUDO[@]}" pkill -KILL -x chromium 2>/dev/null || true
"${SUDO[@]}" pkill -KILL -x chromium-browser 2>/dev/null || true

echo "Chromium stopped."

# ------------------------------------------------------------
# Install the Google OAuth configuration.
#
# The distribution-provided "apikeys" file remains untouched.
#
# Files in /etc/chromium.d are processed by name.
# The "zz-" prefix makes this file load after the normal
# distribution configuration.
# ------------------------------------------------------------

echo
echo "Installing Google OAuth configuration..."

cat <<'EOF' | "${SUDO[@]}" tee /etc/chromium.d/zz-google-sync >/dev/null
# Google account sign-in and Sync for Chromium.
#
# Loaded after the distribution-provided Chromium API
# configuration in /etc/chromium.d/apikeys.

export GOOGLE_DEFAULT_CLIENT_ID="77185425430.apps.googleusercontent.com"
export GOOGLE_DEFAULT_CLIENT_SECRET="OTJgUOQcT7lO7GsGZq2G4IlT"
EOF

"${SUDO[@]}" chmod 644 /etc/chromium.d/zz-google-sync

# ------------------------------------------------------------
# Enable browser sign-in system-wide.
#
# BrowserSignin = 1 allows browser sign-in.
# It does NOT force users to sign in.
# ------------------------------------------------------------

echo "Installing system-wide Chromium sign-in policy..."

"${SUDO[@]}" mkdir -p /etc/chromium/policies/managed

cat <<'EOF' | "${SUDO[@]}" tee /etc/chromium/policies/managed/zz-google-signin.json >/dev/null
{
  "BrowserSignin": 1
}
EOF

"${SUDO[@]}" chmod 644 /etc/chromium/policies/managed/zz-google-signin.json

# ------------------------------------------------------------
# Install profile compatibility support.
#
# Some Chromium versions also store per-profile sign-in state
# in ~/.config/chromium/<profile>/Preferences.
# ------------------------------------------------------------

echo "Installing Chromium profile compatibility support..."

cat <<'EOF' | "${SUDO[@]}" tee /etc/chromium.d/zz-google-sync-signin >/dev/null
# Keep Chromium profile sign-in enabled.

python3 - <<'PY'
import json
import os

base = os.path.expanduser("~/.config/chromium")

if not os.path.isdir(base):
    raise SystemExit

profiles = [
    name
    for name in os.listdir(base)
    if name == "Default" or name.startswith("Profile ")
]

for profile in profiles:
    filename = os.path.join(base, profile, "Preferences")

    if not os.path.isfile(filename):
        continue

    try:
        with open(filename, "r", encoding="utf-8") as file:
            prefs = json.load(file)

        signin = prefs.setdefault("signin", {})
        signin["allowed"] = True
        signin["allowed_on_next_startup"] = True

        with open(filename, "w", encoding="utf-8") as file:
            json.dump(prefs, file, separators=(",", ":"))

    except Exception as error:
        print(f"Chromium Google Sync: could not update {filename}: {error}")
PY
EOF

"${SUDO[@]}" chmod 644 /etc/chromium.d/zz-google-sync-signin

# ------------------------------------------------------------
# Installation finished.
# ------------------------------------------------------------

echo
echo "=================================================="
echo " Installation complete"
echo "=================================================="
echo
echo "Installed:"
echo "  /etc/chromium.d/zz-google-sync"
echo "  /etc/chromium.d/zz-google-sync-signin"
echo "  /etc/chromium/policies/managed/zz-google-signin.json"
echo
echo "Start Chromium and sign in with your Google account."
echo
echo "To verify the machine policy, open:"
echo "  chrome://policy"
